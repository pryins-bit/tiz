{
  "name": "tiz-korea-tv",
  "version": "0.3.0",
  "type": "module",
  "description": "One-click Korea IPTV player and remote-friendly TV home for TizenBrew with optional Mom TV dashboard",
  "packageType": "app",
  "appName": "Korea TV",
  "appPath": "app/index.html",
  "keys": [
    "MediaPlay",
    "MediaPause",
    "MediaPlayPause",
    "MediaStop",
    "ChannelUp",
    "ChannelDown",
    "ColorF0Red",
    "ColorF1Green",
    "ColorF2Yellow",
    "ColorF3Blue"
  ],
  "evaluateScriptOnDocumentStart": false,
  "files": [
    "app",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ]
}
